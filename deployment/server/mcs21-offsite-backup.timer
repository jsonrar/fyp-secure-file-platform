[Unit]
Description=Encrypted off-server backup of MCS21, daily (24-hour RPO)

[Timer]
# Daily meets the 24-hour RPO in docs/BACKUP_AND_RECOVERY.md. 02:30 keeps it clear of
# mcs21-reconcile.timer's midnight window, so a backup never overlaps a storage cleanup.
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=10m
Persistent=true
Unit=mcs21-offsite-backup.service

[Install]
WantedBy=timers.target
