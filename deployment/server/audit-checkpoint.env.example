# Copy to /etc/fyp-secure-file-platform/audit-checkpoint.env as root and chmod 0600.
# Never commit the real values. The HMAC key should be at least 32 random bytes and must not
# be reused as the application SECRET_KEY or a database/password credential.
AUDIT_CHECKPOINT_HMAC_KEY=replace-with-a-random-secret-at-deploy-time

# Production/staging must use an external append-only/locked destination. The existing R2
# bucket may use a dedicated prefix, for example:
AUDIT_CHECKPOINT_DEST=s3://replace-with-locked-bucket/secureview-audit-checkpoints

# Optional for Cloudflare R2 or another S3-compatible provider.
AUDIT_CHECKPOINT_S3_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com

# Supply put-only S3 credentials through this root-only file or another systemd credential
# mechanism. These placeholders are intentionally unusable.
AWS_ACCESS_KEY_ID=replace-at-deploy-time
AWS_SECRET_ACCESS_KEY=replace-at-deploy-time
