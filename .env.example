# Backend
APP_NAME="Secure File Encryption Platform"
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=fyp_user
DB_PASSWORD=fyp_password
DB_NAME=fyp_secure_file_platform

# Storage
ENCRYPTED_FILE_DIR=backend/encrypted_files
TEMP_FILE_DIR=backend/temp_files

# Recovery public key path for demo only
RECOVERY_PUBLIC_KEY_PATH=recovery_keys/recovery_public.pem
